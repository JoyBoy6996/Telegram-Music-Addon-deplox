# Telegram Music Addon - Environment Configuration
# Copy this file to .env and fill in your values.

# Telegram Credentials (Required)
# Get your API ID and Hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generated automatically by the setup wizard or npm run login:
TELEGRAM_SESSION_STRING=

# Music channel numeric ID (e.g. -1001234567890) or channel username:
TELEGRAM_CHANNEL=

# Server & Network (Optional)
# Server port (default: 3000)
PORT=3000

# Secret path protection token (auto-generated if left blank)
# Example: URL_SECRET=mysecret creates /mysecret/manifest.json
URL_SECRET=

# Custom domain or reverse proxy (e.g. https://music.yourdomain.com or Tailscale Funnel URL)
PUBLIC_URL=

# Start Cloudflare HTTPS Quick Tunnel automatically (default: true)
ENABLE_CLOUDFLARE_TUNNEL=true

# Bot Automation (Optional)
# Bot token from @BotFather for duplicate alerts and channel cleaning
TELEGRAM_BOT_TOKEN=
ENABLE_BOT_SYNC=false

# Bot Pool for Concurrent Streaming (Optional, up to 20 bots)
# Comma-separated list of bot tokens from @BotFather to scale downloads
# Example: TELEGRAM_BOT_TOKENS=123456:ABC-DEF...,789012:GHI-JKL...
TELEGRAM_BOT_TOKENS=

# Channel Notifications (Optional)
# Post periodic deduplication summaries to the channel (default: false)
ENABLE_CHANNEL_NOTIFICATIONS=false
